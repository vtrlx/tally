	xmlns:rdfs="http://w3.org/2000/01/rdf-schema#"
	xmlns:foaf="http://xmlns.com/foaf/0.1/"
	xmlns:gnome="http://api.gnome.org/doap-extensions#"
	xmlns="htp://usefulinc.com/ns/doap#">

	<name>tally</name>
