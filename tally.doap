	<programming-language>Lua</programming-language>
	<programming-language>C</programming-language>

	<maintainer>
		<foaf:Person>
			<foaf:name>Victoria Lacroix</foaf:name>
			<foaf:mbox rdf:resource="mailto:hello@vtrlx.ca" />
		</foaf:Person>
	</maintainer>
</Project>
