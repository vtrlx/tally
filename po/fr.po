#: tally.lua:280 tally.lua:749
msgid "Name"
msgstr "Nom"

#: tally.lua:295
msgid "Move to top"
msgstr "Mettre au début"

#: tally.lua:298
msgid "Move counter to the top of the current list"
msgstr "Mettre ce compteur au début de la liste présente"

#: tally.lua:304
msgid "Move to bottom"
msgstr "Mettre à la fin"

#: tally.lua:307
msgid "Move counter to the bottom of the current list"
msgstr "Mettre ce compteur à la fin de la liste présente"

#: tally.lua:322
msgid "Move up"
msgstr "Mettre dessus"

#: tally.lua:325
msgid "Move counter to just above the previous row"
msgstr "Mettre ce compteur juste au dessus le compteur précédent"

#: tally.lua:332
msgid "Move down"
msgstr "Mettre dessous"

#: tally.lua:335
msgid "Move counter to just below the next row"
msgstr "Mettre ce compteur juste dessous le compteur suivant"

#: tally.lua:362
msgid "Create a new window for this counter"
msgstr "Créer une nouvelle fenêtre pour ce compteur"

#: tally.lua:369
msgid "Show in a separate window"
msgstr "Montrer dans une autre fenêtre"

#: tally.lua:452 tally.lua:619 tally.lua:665 tally.lua:911
msgid "Tally"
msgstr "Compteur"

#: tally.lua:628
msgid "Send a tip!"
msgstr "Envoyer un pourboire!"

#: tally.lua:643
msgid "Create a new counter"
msgstr "Créer un nouveau compteur"

#: tally.lua:647
msgid "Delete selected counters"
msgstr "Supprimer compteurs sélectionnés"

#: tally.lua:653
msgid "Filter counters by name and/or color"
msgstr "Filtrer les compteurs par nom et couleur"

#: tally.lua:657
msgid "About Tally"
msgstr "À propos Compteur"

#: tally.lua:661 tally.lua:810
msgid "Select counters to delete"
msgstr "Sélectionner des compteurs pour supprimer"

#: tally.lua:674
msgid "Filter by name…"
msgstr "Filtrer par nom…"

#: tally.lua:740
msgid "Add to list"
msgstr "Ajouter à la liste"

#: tally.lua:742
msgid "Add this counter to the list"
msgstr "Ajouter ce compteur à la liste"

#: tally.lua:806
msgid "Stop selecting without deleting anything"
msgstr "Arrêter la sélection et ne rien supprimer"
