msgstr "Name"

#: counter.lua:246
msgid "Color"
msgstr "Warna"

#: counter.lua:255
msgid "Move to top"
msgstr "Pindah ke paling atas"

#: counter.lua:258
msgid "Move counter to the top of the current list"
msgstr "Pindahkan penghitung ke baris teratas pada list ini"

#: counter.lua:264
msgid "Move to bottom"
msgstr "Pindah ke paling bawah"

#: counter.lua:267
msgid "Move counter to the bottom of the current list"
msgstr "Pindahkan penghitung ke baris terbawah pada list ini"

#: counter.lua:282
msgid "Move up"
msgstr "Geser ke atas"

#: counter.lua:285
msgid "Move counter to just above the previous row"
msgstr "Pindahkan penghitung ke tepat di atas baris sebelumnya"

#: counter.lua:292
msgid "Move down"
msgstr "Geser ke bawah"

#: counter.lua:295
msgid "Move counter to just below the next row"
msgstr "Pindahkan penghitung ke tepat di bawah baris selanjutnya"

#: counter.lua:322
msgid "Create a new window for this counter"
msgstr "Buat jendela baru untuk penghitung ini"

#: counter.lua:329
msgid "Show in a separate window"
msgstr "Tampilkan di jendela terpisah"

